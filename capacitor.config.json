{
  "appId": "com.goodchat.app",
  "appName": "Good Chat",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false,
    "backgroundColor": "#0D7A5F"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#0D7A5F",
      "showSpinner": false
    }
  }
}

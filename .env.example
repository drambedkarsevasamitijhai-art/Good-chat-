# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ANDROID_APK_URL: Optional hosted URL to a signed Android .apk build for direct download.
# Leave empty to use instant PWA installation and GitHub Actions / PWABuilder APK builds.
ANDROID_APK_URL=""

# GITHUB_REPO_URL: Optional GitHub repository URL (e.g. https://github.com/username/good-chat)
# Links the in-app APK download modal directly to your GitHub Actions APK Releases.
GITHUB_REPO_URL=""

# VITE_API_BASE_URL: Optional backend origin baked into standalone Android APK builds.
VITE_API_BASE_URL=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
